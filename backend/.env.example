# Never use the development defaults in a deployed environment.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
MONGO_URI=mongodb://localhost:27017/aase
MONGO_DB=aase
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI/OCR settings. They are not loaded during Flask startup.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ENABLE_EMBEDDING_MODEL=false
PADDLE_OCR_DEVICE=cpu
