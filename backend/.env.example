# Never commit the real backend/.env file.
# In production, generate both secrets randomly. Each must be at least 32 bytes,
# and SECRET_KEY and JWT_SECRET_KEY must be different from one another.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
JWT_SECRET_KEY=replace-with-a-different-random-secret-of-at-least-32-bytes
MONGO_URI=mongodb://localhost:27017/aase
MONGO_DB=aase
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI/OCR settings. They are not loaded during Flask startup.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ENABLE_EMBEDDING_MODEL=false
PADDLE_OCR_DEVICE=cpu
